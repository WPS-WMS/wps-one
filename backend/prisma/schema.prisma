model ProjectRevenue {
  id                  String    @id @default(cuid())
  tenantId            String
  projectId           String
  billingTypeId       String?
  title               String?
  /// Valor contratado / total do contrato (R$).
  contractedValue     Float?
  expectedRevenue     Float?
  realizedRevenue     Float?
  installmentCount    Int?
  startDate           DateTime?
  endDate             DateTime?
  /// NEGOCIACAO | ATIVO | FINALIZADO | CANCELADO
  status              String    @default("NEGOCIACAO")
  isAdditive          Boolean   @default(false)
  /// Quando true, parcelas de faturamento são recalculadas a partir do total de custos.
  autoBillingCalculation Boolean @default(true)
  /// Imposto configurado em Configurações > Impostos, aplicado sobre a base da receita.
  taxTypeId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  billingType  ProjectBillingType?       @relation(fields: [billingTypeId], references: [id], onDelete: SetNull)
  taxType      TaxType?                  @relation(fields: [taxTypeId], references: [id], onDelete: SetNull)
  history      ProjectRevenueHistory[]
  receivable   Receivable?
  costLines    ProjectRevenueCostLine[]
  billingLines ProjectRevenueBillingLine[]

  @@index([tenantId, projectId, status], map: "project_revenues_tenant_project_status_idx")
  @@index([projectId, createdAt], map: "project_revenues_project_created_idx")
  @@map("project_revenues")
}

