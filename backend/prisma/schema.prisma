  @@index([tenantId, financialAccountId, entryDate], map: "financial_entries_tenant_account_date_idx")
  @@index([tenantId, projectId], map: "financial_entries_tenant_project_idx")
  @@index([tenantId, entryDate, status], map: "financial_entries_tenant_date_status_idx")
  @@map("financial_entries")
