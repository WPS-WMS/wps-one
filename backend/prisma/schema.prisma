model TaxType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// Alíquota do imposto em percentual (ex.: 15.5 = 15,5%).
  ratePercent Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectRevenues ProjectRevenue[]

  @@unique([tenantId, name], map: "tax_types_tenant_name_uq")
  @@index([tenantId, isActive, name], map: "tax_types_tenant_active_name_idx")
  @@map("tax_types")
}

model PayableRecurrenceRule {
  id                    String    @id @default(cuid())
  tenantId              String
  supplierId            String?
  financialAccountId    String
  corporateExpenseTypeId String?
  defaultCostCenterId   String?
  projectId             String?
  description           String
  amountCents           Int
  /// MENSAL | BIMESTRAL | TRIMESTRAL | SEMESTRAL | ANUAL
  frequency             String    @default("MENSAL")
  dayOfMonth            Int       @default(1)
  startDate             DateTime  @db.Date
  endDate               DateTime? @db.Date
  nextDueDate           DateTime  @db.Date
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier            Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  financialAccount    FinancialAccount     @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  corporateExpenseType CorporateExpenseType? @relation(fields: [corporateExpenseTypeId], references: [id], onDelete: SetNull)
  payables            Payable[]

  @@index([tenantId, isActive, nextDueDate], map: "payable_recurrence_tenant_active_next_idx")
  @@map("payable_recurrence_rules")
}

model Payable {
  id                     String    @id @default(cuid())
  tenantId               String
  supplierId             String?
  professionalUserId     String?
  payeeName              String?
  financialAccountId     String
  financialCategoryId    String?
  corporateExpenseTypeId String?
  contractTypeId         String?
  description            String
  totalAmountCents       Int
  hourRateCents          Int?
  benefitCents           Int?
  reimbursementCents     Int?
  discountCents          Int?
  complementaryHours     Float?
  interestFineCents      Int?
  competenceDate       DateTime? @db.Date
  /// MANUAL | CORPORATIVA | REEMBOLSO
  kind                   String    @default("MANUAL")
  /// ABERTO | PAGO | VENCIDO | CANCELADO | PENDENTE_APROVACAO
  status                 String    @default("ABERTO")
  /// REIMBURSEMENT | RECURRENCE
  sourceType             String?
  sourceId               String?   @unique
  reimbursementId        String?   @unique
  recurrenceRuleId       String?
  requiresApproval       Boolean   @default(false)
  approvedById           String?
  approvedAt             DateTime?
  createdById            String
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  professional         User?                 @relation("PayableProfessional", fields: [professionalUserId], references: [id], onDelete: SetNull)
  financialAccount     FinancialAccount      @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  financialCategory    FinancialCategory?    @relation(fields: [financialCategoryId], references: [id], onDelete: SetNull)
  corporateExpenseType CorporateExpenseType? @relation(fields: [corporateExpenseTypeId], references: [id], onDelete: SetNull)
  contractType         ContractType?         @relation(fields: [contractTypeId], references: [id], onDelete: SetNull)
  reimbursement        Reimbursement?        @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)
  recurrenceRule       PayableRecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  createdBy            User                  @relation("PayableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy           User?                 @relation("PayableApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  installments         PayableInstallment[]
  allocations          PayableAllocation[]
  attachments          PayableAttachment[]
  history              PayableHistory[]

  @@index([tenantId, status, createdAt], map: "payables_tenant_status_created_idx")
  @@index([tenantId, kind, status], map: "payables_tenant_kind_status_idx")
  @@map("payables")
}

model PayableInstallment {
  id               String    @id @default(cuid())
  payableId        String
  installmentNumber Int
  dueDate          DateTime  @db.Date
  amountCents      Int
  paidAt           DateTime?
  /// ABERTO | PAGO | VENCIDO | CANCELADO
  status           String    @default("ABERTO")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payable         Payable          @relation(fields: [payableId], references: [id], onDelete: Cascade)
  financialEntry  FinancialEntry?

  @@unique([payableId, installmentNumber], map: "payable_installments_payable_number_uq")
  @@index([payableId, dueDate], map: "payable_installments_payable_due_idx")
  @@index([status, dueDate], map: "payable_installments_status_due_idx")
  @@map("payable_installments")
}

model PayableAllocation {
  id           String  @id @default(cuid())
  payableId    String
  costCenterId String
  projectId    String?
  /// Percentual em basis points (10000 = 100%)
  percentBps   Int
  amountCents  Int

  payable    Payable    @relation(fields: [payableId], references: [id], onDelete: Cascade)
  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([payableId], map: "payable_allocations_payable_idx")
  @@map("payable_allocations")
}

model PayableAttachment {
  id         String   @id @default(cuid())
  payableId  String
  userId     String
  filename   String
  fileUrl    String
  fileType   String
  fileSize   Int
  /// Conteúdo do arquivo persistido (BYTEA). Preferência sobre disco em ambientes efêmeros.
  fileContent Bytes?
  /// NOTA_FISCAL | BOLETO | COMPROVANTE | OUTRO
  category   String   @default("OUTRO")
  createdAt  DateTime @default(now())

  payable Payable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  user    User    @relation("PayableAttachmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([payableId, createdAt], map: "payable_attachments_payable_created_idx")
  @@map("payable_attachments")
}

model PayableHistory {
  id        String   @id @default(cuid())
  payableId String
  userId    String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  details   String?
  createdAt DateTime @default(now())

  payable Payable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  user    User    @relation("PayableHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([payableId, createdAt], map: "payable_history_payable_created_idx")
  @@map("payable_history")
}

// ---------------------------------------------------------------------------
// Financeiro — Contas a Receber e Faturamento
// ---------------------------------------------------------------------------

model ReceivableRecurrenceRule {
  id                   String    @id @default(cuid())
  tenantId             String
  clientId             String?
  financialAccountId   String
  projectId            String?
  defaultCostCenterId  String?
  description          String
  amountCents          Int
  /// MENSAL | BIMESTRAL | TRIMESTRAL | SEMESTRAL | ANUAL
  frequency            String    @default("MENSAL")
  dayOfMonth           Int       @default(1)
  startDate            DateTime  @db.Date
  endDate              DateTime? @db.Date
  nextDueDate          DateTime  @db.Date
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  receivables      Receivable[]

  @@index([tenantId, isActive, nextDueDate], map: "receivable_recurrence_tenant_active_next_idx")
  @@map("receivable_recurrence_rules")
}

model Receivable {
  id                   String    @id @default(cuid())
  tenantId             String
  clientId             String
  projectId            String?
  projectRevenueId     String?   @unique
  financialAccountId   String
  description          String
  totalAmountCents     Int
  netAmountCents       Int?
  taxAmountCents       Int?
  retentionAmountCents Int?
  competenceDate       DateTime? @db.Date
  /// MANUAL | PROJETO | RECORRENTE
  kind                 String    @default("MANUAL")
  /// PREVISTO | FATURADO | RECEBIDO | ATRASADO | CANCELADO
  status               String    @default("PREVISTO")
  sourceType           String?
  sourceId             String?   @unique
  recurrenceRuleId     String?
  createdById          String
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project          Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectRevenue   ProjectRevenue?           @relation(fields: [projectRevenueId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount          @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  recurrenceRule   ReceivableRecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  createdBy        User                      @relation("ReceivableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  installments     ReceivableInstallment[]
  invoice          ReceivableInvoice?
  allocations      ReceivableAllocation[]
  history          ReceivableHistory[]

  @@index([tenantId, status, createdAt], map: "receivables_tenant_status_created_idx")
  @@index([tenantId, clientId], map: "receivables_tenant_client_idx")
  @@index([tenantId, competenceDate], map: "receivables_tenant_competence_idx")
  @@map("receivables")
}

model ReceivableInvoice {
  id                   String   @id @default(cuid())
  receivableId         String   @unique
  nfNumber             String
  nfSeries             String?
  emissionDate         DateTime @db.Date
  grossAmountCents     Int
  netAmountCents       Int
  taxAmountCents       Int      @default(0)
  retentionAmountCents Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([emissionDate], map: "receivable_invoices_emission_idx")
  @@map("receivable_invoices")
}

model ReceivableInstallment {
  id                String    @id @default(cuid())
  receivableId      String
  installmentNumber Int
  dueDate           DateTime  @db.Date
  amountCents       Int
  receivedAt        DateTime?
  /// PREVISTO | FATURADO | RECEBIDO | ATRASADO | CANCELADO
  status            String    @default("PREVISTO")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  receivable       Receivable      @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  financialEntry   FinancialEntry?

  @@unique([receivableId, installmentNumber], map: "receivable_installments_receivable_number_uq")
  @@index([receivableId, dueDate], map: "receivable_installments_receivable_due_idx")
  @@index([status, dueDate], map: "receivable_installments_status_due_idx")
  @@map("receivable_installments")
}

model ReceivableAllocation {
  id           String @id @default(cuid())
  receivableId String
  costCenterId String
  projectId    String?
  percentBps   Int
  amountCents  Int

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([receivableId], map: "receivable_allocations_receivable_idx")
  @@map("receivable_allocations")
}

model ReceivableHistory {
  id           String   @id @default(cuid())
  receivableId String
  userId       String
  action       String
  field        String?
  oldValue     String?
  newValue     String?
  details      String?
  createdAt    DateTime @default(now())

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  user       User       @relation("ReceivableHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([receivableId, createdAt], map: "receivable_history_receivable_created_idx")
  @@map("receivable_history")
}
