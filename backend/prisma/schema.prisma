// Banco: PostgreSQL (Supabase/Railway)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
  activities Activity[]
  featurePermissions TenantFeaturePermission[]
  counters  TenantCounter[]
  projectGroups ProjectGroup[]
  portalSections PortalSection[]
  portalItems    PortalItem[]
  portalEvents   PortalEvent[]
  emailNotificationRules TenantEmailNotificationRule[]
  kanbanColumns KanbanColumn[]
  holidays  TenantHoliday[]
  timeEntryPermissionRequests TimeEntryPermissionRequest[]
  reimbursementTypes ReimbursementType[]
  reimbursementLimits ReimbursementProjectLimit[]
  reimbursements Reimbursement[]
  tmMonthPlans TenantTmMonthPlan[]
  supplierCategories SupplierCategory[]
  costCenters CostCenter[]
  costCenterBudgets CostCenterBudget[]
  financialAccounts FinancialAccount[]
  suppliers Supplier[]
  clientFinancials ClientFinancial[]
  projectBillingTypes ProjectBillingType[]
  contractTypes ContractType[]
  projectRevenues ProjectRevenue[]
  projectContracts ProjectContract[]
  financialEntries FinancialEntry[]
  corporateExpenseTypes CorporateExpenseType[]
  revenueTypes RevenueType[]
  taxTypes TaxType[]
  financialCategories FinancialCategory[]
  payables Payable[]
  payableRecurrenceRules PayableRecurrenceRule[]
  receivables Receivable[]
  receivableRecurrenceRules ReceivableRecurrenceRule[]
  /// Integração Microsoft SharePoint / Teams
  sharePointEnabled            Boolean  @default(false)
  sharePointSiteUrl            String?
  sharePointDriveId            String?
  sharePointRootFolderPath     String?  @default("Projetos WPSone")
  sharePointRootFolderItemId   String?
}

/// Planeamento mensal/semanal agregado na aba «Total T&M + AMS» (independente dos planos por projeto).
model TenantTmMonthPlan {
  id             String   @id @default(cuid())
  tenantId       String
  year           Int
  month          Int
  mesPlanejado   Float?
  weekPlanHoras  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
  @@index([tenantId, year, month])
  @@map("tenant_tm_month_plans")
}

model ProjectGroup {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@unique([tenantId, name])
  @@index([tenantId, name])
  @@map("project_groups")
}

model TenantFeaturePermission {
  id        String   @id @default(cuid())
  tenantId  String
  featureId String
  role      String
  state     String   @default("allow") // allow | deny
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId, role])
  @@index([tenantId, role])
  @@map("tenant_feature_permissions")
}

model TenantCounter {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "tenant_counters_tenant_key_uq")
  @@index([tenantId], map: "tenant_counters_tenant_idx")
  @@map("tenant_counters")
}

/// Regras de e-mail por tipo de projeto (TipoProjeto) e gatilho (CRIACAO, STATUS_CHANGE, ...).
model TenantEmailNotificationRule {
  id          String   @id @default(cuid())
  tenantId    String
  projectType String
  trigger     String
  isActive    Boolean  @default(true)
  /// JSON array: RESPONSAVEL | MEMBRO | CLIENTE
  recipientRoles String @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectType, trigger], map: "ten_email_rules_tpt_trig_uq")
  @@index([tenantId], map: "ten_email_rules_tenant_idx")
  @@map("tenant_email_notification_rules")
}

model User {
  id                    String   @id @default(cuid())
  email                 String
  name                  String
  passwordHash          String
  role                  String
  tenantId              String
  cargo                 String?
  avatarUrl             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  cargaHorariaSemanal   Float?   @default(40)
  /// Taxa hora interna (custo) usada no dashboard financeiro do projeto.
  hourlyRate            Float?
  /// Vínculo contratual da pessoa: PJ | CLT | COOPERADO | SOCIEDADE
  employmentType        String?
  limiteHorasDiarias    Float?   @default(8)
  /// JSON com horas permitidas por dia: { "dom": 0, "seg": 8, ... }
  limiteHorasPorDia     String?
  permitirMaisHoras     Boolean  @default(false)
  permitirFimDeSemana   Boolean  @default(false)
  permitirOutroPeriodo  Boolean  @default(false)
  /// NAO_PERMITIR | ENVIAR_APROVACAO
  violacaoApontamentoModo String @default("NAO_PERMITIR")
  diasPermitidos        String?
  dataInicioAtividades  DateTime?
  birthDate             DateTime?
  mustChangePassword    Boolean  @default(true)
  ativo                 Boolean  @default(true)
  inativadoEm           DateTime?
  inativacaoMotivo      String?

  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdProjects       Project[]     @relation("ProjectCreator")
  timeEntries           TimeEntry[]
  assignedTickets       Ticket[]      @relation("AssignedConsultant")
  createdTickets        Ticket[]      @relation("TicketCreator")
  ticketResponsibles    TicketResponsible[]
  ticketComments        TicketComment[]
  ticketHistory         TicketHistory[] @relation("TicketHistoryUser")
  ticketAttachments     TicketAttachment[] @relation("TicketAttachmentUser")
  ticketBudgetsSent     TicketBudget[] @relation("TicketBudgetSentBy")
  ticketBudgetsDecided  TicketBudget[] @relation("TicketBudgetDecidedBy")
  passwordResetTokens   PasswordResetToken[]
  hourBankRecords       HourBankRecord[]
  clientAccess          ClientUser[]  @relation("ClientUser")
  projectResponsibles  ProjectResponsible[]  @relation("ProjectResponsible")
  projectMemberships   ProjectMember[]       @relation("ProjectMember")
  defaultTaskAssigneeProjects Project[]    @relation("ProjectDefaultTaskAssignee")
  timeEntryPermissionRequests TimeEntryPermissionRequest[] @relation("TimeEntryPermissionRequestUser")
  reimbursements Reimbursement[]
  reviewedReimbursements Reimbursement[] @relation("ReimbursementReviewedBy")
  supplierHistory SupplierHistory[] @relation("SupplierHistoryUser")
  supplierAttachments SupplierAttachment[] @relation("SupplierAttachmentUser")
  projectRevenueHistory ProjectRevenueHistory[] @relation("ProjectRevenueHistoryUser")
  projectContractHistory ProjectContractHistory[] @relation("ProjectContractHistoryUser")
  projectContractAttachments ProjectContractAttachment[] @relation("ProjectContractAttachmentUser")
  financialEntriesCreated FinancialEntry[] @relation("FinancialEntryCreatedBy")
  costCenterBudgetsCreated CostCenterBudget[] @relation("CostCenterBudgetCreatedBy")
  payablesCreated Payable[] @relation("PayableCreatedBy")
  payablesApproved Payable[] @relation("PayableApprovedBy")
  payablesAsProfessional Payable[] @relation("PayableProfessional")
  payableHistory PayableHistory[] @relation("PayableHistoryUser")
  payableAttachments PayableAttachment[] @relation("PayableAttachmentUser")
  receivablesCreated Receivable[] @relation("ReceivableCreatedBy")
  receivableHistory ReceivableHistory[] @relation("ReceivableHistoryUser")
  /// Fornecedor vinculado para dados de pagamento / NF (opcional).
  linkedSupplier Supplier? @relation("SupplierLinkedUser")
  @@unique([email, tenantId])
  @@index([tenantId, name])
  @@map("users")
}

model PortalSection {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  slug      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     PortalItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, order])
}

model PortalItem {
  id        String   @id @default(cuid())
  tenantId  String
  sectionId String
  title     String
  content   String
  type      String
  metadata  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   PortalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sectionId])
}

model PortalEvent {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  description String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  email     String?
  cnpj      String?
  telefone  String?
  cep       String?
  endereco  String?
  numero    String?
  complemento String?
  bairro    String?
  cidade    String?
  estado    String?
  /** Integração SharePoint: equipe Teams / site do cliente */
  sharePointEnabled          Boolean  @default(false)
  sharePointSiteUrl          String?
  sharePointDriveId          String?
  sharePointRootFolderPath   String?  @default("Projetos WPSone")
  sharePointRootFolderItemId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects  Project[]
  users     ClientUser[]
  contacts  ClientContact[]
  financial ClientFinancial?
  receivables Receivable[]
  receivableRecurrenceRules ReceivableRecurrenceRule[]
  @@index([tenantId, name])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  telefone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([clientId, createdAt])
}

model ClientUser {
  id       String  @id @default(cuid())
  userId   String
  clientId String
  user     User    @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
  @@index([clientId, userId])
}

enum TipoProjeto {
  INTERNO
  CUSTOS_OPERACIONAIS
  FIXED_PRICE
  AMS
  TIME_MATERIAL
}

model Project {
  id                    String    @id @default(cuid())
  name                  String
  description           String?
  clientId              String
  createdAt             DateTime  @default(now())
  createdById           String
  createdBy             User      @relation("ProjectCreator", fields: [createdById], references: [id])
  client                Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dataInicio            DateTime?
  dataFimPrevista       DateTime?
  prioridade            String?
  totalHorasPlanejadas  Float?
  statusInicial         String    @default("PLANEJADO")
  obrigatoriosHoras     Boolean   @default(false)
  obrigatoriosDataEntrega Boolean @default(false)
  /** Quando true, o projeto entra no filtro "Operação" do Dashboard Daily. */
  operacaoAtivo         Boolean   @default(false)
  projectGroupId        String?
  projectGroup          ProjectGroup? @relation(fields: [projectGroupId], references: [id], onDelete: SetNull)
  /// Projeto pai (ex.: change request vinculada ao projeto original).
  parentProjectId       String?
  parentProject         Project?  @relation("ProjectHierarchy", fields: [parentProjectId], references: [id], onDelete: SetNull)
  childProjects         Project[] @relation("ProjectHierarchy")
  /** Membro do projeto que recebe tarefas abertas pelo cliente (quando configurado). */
  defaultTaskAssigneeId String?
  defaultTaskAssignee   User?         @relation("ProjectDefaultTaskAssignee", fields: [defaultTaskAssigneeId], references: [id], onDelete: SetNull)
  
  // Tipo e configurações do projeto
  tipoProjeto TipoProjeto? @default(INTERNO)

  kanbanColumns KanbanColumn[]
  
  // Configurações Fixed Price
  valorContrato Float?
  escopoInicial String?
  limiteHorasEscopo Float?
  changeRequestsAtivo Boolean? @default(false)
  
  // Configurações AMS
  tipoContratoAMS String? // MENSAL_FIXO, BANCO_HORAS
  horasMensaisAMS Float?
  bancoHorasInicial Float?
  slaAMS Int? // dias
  slaRespostaBaixa Int?
  slaSolucaoBaixa Int?
  slaRespostaMedia Int?
  slaSolucaoMedia Int?
  slaRespostaAlta Int?
  slaSolucaoAlta Int?
  slaRespostaCritica Int?
  slaSolucaoCritica Int?
  
  // Configurações Time & Material
  periodoAprovacaoTM String? // MENSAL, QUINZENAL
  aprovacaoAutomaticaTM Boolean? @default(false)
  estimativaInicialTM Float?
  
  // Anexo de proposta comercial e escopo
  anexoNomeArquivo String?
  anexoUrl String? // URL ou path do arquivo
  anexoTipo String? // application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document
  anexoTamanho Int? // tamanho em bytes
  
  // Status de arquivamento
  arquivado Boolean @default(false)
  arquivadoEm DateTime?
  
  tickets               Ticket[]
  timeEntries           TimeEntry[]
  activities            ActivityProject[]
  responsibles          ProjectResponsible[]
  members               ProjectMember[]
  timeEntryPermissionRequests TimeEntryPermissionRequest[]
  reimbursements Reimbursement[]
  reimbursementLimits ReimbursementProjectLimit[]
  tmMonthPlans ProjectTmMonthPlan[]
  revenues     ProjectRevenue[]
  contracts    ProjectContract[]
  financialEntries FinancialEntry[]
  payableAllocations PayableAllocation[]
  receivableAllocations ReceivableAllocation[]
  receivables Receivable[]
  receivableRecurrenceRules ReceivableRecurrenceRule[]

  sharePointFolderId     String?
  sharePointFolderUrl    String?
  sharePointSyncStatus   String?
  sharePointSyncError    String?

  @@index([clientId, arquivado, createdAt])
  @@index([clientId, projectGroupId])
  @@index([parentProjectId], map: "projects_parent_idx")
}

/// Planeamento mensal/semanal (horas) para ecrã Gestão T&M — projetos AMS e Time & Material.
model ProjectTmMonthPlan {
  id             String   @id @default(cuid())
  projectId      String
  year           Int
  month          Int
  mesPlanejado   Float?
  weekPlanHoras  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, year, month])
  @@index([projectId, year, month])
  @@map("project_tm_month_plans")
}

/// Colunas customizadas do Kanban persistidas por projeto (visível para todos os usuários do tenant).
model KanbanColumn {
  /// ID público usado como status nos tickets (ex.: CUSTOM_EM_QA_1712345678901)
  id        String   @id
  tenantId  String
  projectId String
  label     String
  color     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, id], map: "kanban_columns_project_id_uq")
  @@index([tenantId, projectId, deletedAt, order], map: "kanban_columns_tenant_project_idx")
  @@map("kanban_columns")
}

model ProjectResponsible {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("ProjectResponsible", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
  @@index([userId, projectId])
}

/// Membros do projeto: possuem visualização de todos os tópicos/tarefas do projeto.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("ProjectMember", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model Ticket {
  id              String   @id @default(cuid())
  code            String
  title           String
  description     String?
  type            String
  criticidade     String?
  status          String   @default("ABERTO")
  /** Prioridade manual da fila do consultor (1 = mais prioritária). */
  queuePriority   Int?
  finalizacaoMotivo String?
  finalizacaoObservacao String?
  projectId       String
  parentTicketId  String?  // ID do subprojeto pai (se esta tarefa pertence a um subprojeto)
  createdById     String?
  assignedToId   String?
  dataInicio      DateTime? // Data de início da tarefa
  dataFimPrevista DateTime? // Data de entrega prevista
  estimativaHoras Float?    // Estimativa de horas (número de horas)
  slaRespostaHoras Int?     // SLA de resposta aplicado na criação (AMS)
  slaSolucaoHoras Int?      // SLA de solução aplicado na criação (AMS)
  progresso       Int?      @default(0) // Progresso em porcentagem (0-100)
  arquivado       Boolean   @default(false)
  arquivadoEm     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTicket    Ticket?  @relation("TicketHierarchy", fields: [parentTicketId], references: [id], onDelete: Cascade)
  childTickets    Ticket[] @relation("TicketHierarchy")
  createdBy       User?    @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo      User?    @relation("AssignedConsultant", fields: [assignedToId], references: [id])
  timeEntries     TimeEntry[]
  responsibles    TicketResponsible[]
  comments        TicketComment[]
  timeEntryPermissionRequests TimeEntryPermissionRequest[]
  history         TicketHistory[]
  attachments     TicketAttachment[]
  budget          TicketBudget?

  sharePointFolderId     String?
  sharePointFolderUrl    String?
  sharePointSyncStatus   String?
  sharePointSyncError    String?
  sharePointDeltaLink    String?

  @@index([projectId, createdAt])
  @@index([projectId, status, createdAt])
  @@index([projectId, arquivado, createdAt], map: "tickets_project_archived_created_idx")
  @@index([assignedToId])
  @@index([createdById])
  @@index([parentTicketId])
}

model TicketBudget {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  status      String   @default("NENHUM") // NENHUM | AGUARDANDO_APROVACAO | APROVADO | REPROVADO
  horas       Float
  observacao  String
  rejectionReason String?
  sentById    String?
  decidedById String?
  sentAt      DateTime?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sentBy      User?    @relation("TicketBudgetSentBy", fields: [sentById], references: [id])
  decidedBy   User?    @relation("TicketBudgetDecidedBy", fields: [decidedById], references: [id])

  @@index([status])
}

model TicketResponsible {
  id       String  @id @default(cuid())
  ticketId String
  userId   String
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([ticketId, userId])
  @@index([userId, ticketId])
}

model Activity {
  id          String      @id @default(cuid())
  name        String
  isActive    Boolean     @default(true)
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  projects    ActivityProject[]
  @@index([tenantId, name])
}

model ActivityProject {
  id         String  @id @default(cuid())
  activityId String
  projectId  String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([activityId, projectId])
  @@index([projectId])
  @@index([activityId])
}

model TimeEntry {
  id              String    @id @default(cuid())
  date            DateTime
  horaInicio      String
  horaFim         String
  intervaloInicio String?
  intervaloFim    String?
  totalHoras      Float
  description     String?
  userId          String
  projectId       String
  ticketId        String?
  activityId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket          Ticket?   @relation(fields: [ticketId], references: [id])
  activity        Activity? @relation(fields: [activityId], references: [id])
  pendingReplaceRequests TimeEntryPermissionRequest[] @relation("TimeEntryPermissionReplaces")
  @@index([userId, date])
  @@index([projectId, date])
  @@index([ticketId, date, horaInicio])
}

model TicketComment {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String
  content     String   // HTML content do comentário
  visibility  CommentVisibility @default(PUBLIC)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments TicketCommentAttachment[]
  @@index([ticketId, createdAt])
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  action    String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, PRIORITY_CHANGE, ASSIGNED, etc
  field     String?  // Campo alterado (title, description, status, etc) - null para CREATE/DELETE
  oldValue  String?  // Valor anterior (JSON string para objetos complexos)
  newValue  String?  // Valor novo (JSON string para objetos complexos)
  details   String?  // Detalhes adicionais da ação
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation("TicketHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  @@index([ticketId])
  @@index([createdAt])
}

model TicketCommentAttachment {
  id        String         @id @default(cuid())
  commentId String
  filename  String
  fileUrl   String         // URL ou path do arquivo
  fileType  String         // image/png, image/jpeg, etc
  fileSize  Int            // tamanho em bytes
  createdAt DateTime       @default(now())
  comment   TicketComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  filename  String
  fileUrl   String   // URL ou path do arquivo
  fileType  String   // MIME type (image/png, application/pdf, etc)
  fileSize  Int      // tamanho em bytes
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation("TicketAttachmentUser", fields: [userId], references: [id], onDelete: Cascade)

  sharePointItemId   String?
  sharePointWebUrl   String?
  sharePointETag     String?
  syncSource         String?
  syncedAt           DateTime?

  @@index([ticketId])
  @@index([sharePointItemId])
}

model TimeEntryPermissionRequest {
  id              String   @id @default(cuid())
  tenantId        String
  seq             Int?
  code            String?
  userId          String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  justification   String
  date            DateTime
  horaInicio      String
  horaFim         String
  intervaloInicio String?
  intervaloFim    String?
  totalHoras      Float
  description     String?
  projectId       String
  ticketId        String?
  activityId      String?
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  /// MAIS_HORAS | FIM_DE_SEMANA_FERIADO | OUTRO_PERIODO | CUSTOS_OPERACIONAIS
  violationRule   String?
  submissionBatchId String?
  createdTimeEntryId String?
  /// Se preenchido, ao aprovar atualiza este TimeEntry em vez de criar um novo (fluxo de edição acima do limite).
  replacesTimeEntryId String?
  replacesTimeEntry   TimeEntry? @relation("TimeEntryPermissionReplaces", fields: [replacesTimeEntryId], references: [id], onDelete: SetNull)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("TimeEntryPermissionRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket    Ticket? @relation(fields: [ticketId], references: [id])
  @@unique([tenantId, seq], map: "time_entry_permission_req_tenant_seq_uq")
  @@index([tenantId, status, createdAt], map: "time_entry_permission_req_tenant_status_created_idx")
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([submissionBatchId])
  @@index([userId, status, date])
  @@index([replacesTimeEntryId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model HourBankRecord {
  id                  String   @id @default(cuid())
  month               Int
  year                Int
  horasPrevistas      Float
  horasTrabalhadas    Float
  horasComplementares Float?
  /// Horas quitadas em pagamento (não acumuladas no banco); reduz o saldo de complementares do mês.
  horasPagas          Float?
  /// Ajuste manual de saldo para importação do sistema anterior (pode ser positivo ou negativo).
  saldoAjuste         Float?
  observacao          String?
  userId              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model TenantHoliday {
  id        String   @id @default(cuid())
  tenantId  String
  /** Data civil do feriado (sem horário). */
  date      DateTime @db.Date
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("tenant_holidays")
}

model ReimbursementType {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  /// FIXO | POR_UNIDADE (coluna TEXT no Postgres via migrations SQL idempotentes).
  calcMode  String   @default("FIXO")
  /// Unidade usada quando calcMode = POR_UNIDADE (ex.: km, litro, diária).
  unit      String?
  /// Se true, a solicitação exige pelo menos um anexo para este tipo.
  attachmentRequired Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reimbursements Reimbursement[]
  projectLimits  ReimbursementProjectLimit[]

  @@unique([tenantId, name], map: "reimbursement_types_tenant_name_uq")
  @@index([tenantId, isActive, name], map: "reimbursement_types_tenant_active_name_idx")
  @@map("reimbursement_types")
}

model ReimbursementProjectLimit {
  id            String   @id @default(cuid())
  tenantId      String
  projectId     String
  typeId        String
  /// Limite do valor total (em centavos) quando o tipo é FIXO.
  maxValueCents     Int?
  /// Valor unitário máximo permitido (em centavos) quando o tipo é POR_UNIDADE.
  maxUnitValueCents Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type    ReimbursementType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, typeId], map: "reimbursement_limits_tenant_project_type_uq")
  @@index([tenantId, projectId], map: "reimbursement_limits_tenant_project_idx")
  @@map("reimbursement_project_limits")
}

model Reimbursement {
  id              String              @id @default(cuid())
  tenantId        String
  userId          String
  projectId       String
  typeId          String
  amountCents     Int
  /// Quantidade informada quando o tipo é POR_UNIDADE (ex.: km rodado).
  quantity        Decimal?            @db.Decimal(12, 3)
  /// Valor unitário em centavos quando o tipo é POR_UNIDADE (ex.: R$ 1,10/km => 110).
  unitValueCents  Int?
  description     String
  /// EMPRESA | CONSULTOR — destinatário do pagamento do reembolso.
  paymentTo       String?
  expenseDate     DateTime? @db.Date
  /// IN_PROGRESS | REJECTED | PAID — coluna TEXT no Postgres (não usar enum PG nativo: Prisma mapeia como String).
  status          String    @default("IN_PROGRESS")
  rejectionReason String?
  paidAt          DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       ReimbursementType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("ReimbursementReviewedBy", fields: [reviewedById], references: [id])
  attachments ReimbursementAttachment[]
  payable     Payable?

  @@index([tenantId, status, createdAt], map: "reimbursements_tenant_status_created_idx")
  @@index([tenantId, userId, createdAt], map: "reimbursements_tenant_user_created_idx")
  @@map("reimbursements")
}

model ReimbursementAttachment {
  id              String   @id @default(cuid())
  reimbursementId String
  filename        String
  fileUrl         String
  fileType        String
  fileSize        Int
  createdAt       DateTime @default(now())

  reimbursement Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@index([reimbursementId, createdAt], map: "reimbursement_attachments_reimbursement_created_idx")
  @@map("reimbursement_attachments")
}

